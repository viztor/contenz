{
  "name": "@contenz/adapter-mdx",
  "version": "0.1.5",
  "description": "Unified MD/MDX format adapter for contenz",
  "license": "MPL-2.0",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "contenz",
    "mdx",
    "markdown",
    "frontmatter",
    "adapter"
  ],
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "@types/node": "^25.9.1",
    "tsup": "^8.5.1",
    "vitest": "^4.1.8"
  },
  "peerDependencies": {
    "@contenz/core": "^0.1.3"
  }
}
