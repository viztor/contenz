{
  "name": "@contenz/adapter-mdx",
  "version": "0.2.0",
  "description": "Unified MD/MDX format adapter for contenz",
  "keywords": [
    "adapter",
    "contenz",
    "frontmatter",
    "markdown",
    "mdx"
  ],
  "homepage": "https://github.com/viztor/contenz#readme",
  "bugs": {
    "url": "https://github.com/viztor/contenz/issues"
  },
  "license": "MPL-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/viztor/contenz.git",
    "directory": "packages/adapter-mdx"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup && tsc --emitDeclarationOnly --declarationMap",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src",
    "lint:fix": "oxlint --fix src"
  },
  "devDependencies": {
    "@contenz/core": "workspace:*",
    "@types/node": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@contenz/core": "^0.2.0"
  },
  "engines": {
    "node": ">=24"
  }
}
