{
  "name": "@contenz/cli",
  "version": "0.1.6",
  "description": "CLI for contenz (content validation and codegen)",
  "license": "MPL-2.0",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "contenz",
    "cli",
    "content",
    "markdown",
    "mdx"
  ],
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "contenz": "./bin/run.mjs"
  },
  "files": [
    "dist",
    "bin"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@contenz/core": "^0.1.6",
    "@contenz/preview": "^0.1.6",
    "@hono/node-server": "^2.0.4",
    "citty": "^0.2.2",
    "get-port-please": "^3.2.0",
    "hono": "^4.12.23",
    "tsx": "^4.22.4"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3"
  }
}
