{
  "name": "@contenz/cli",
  "version": "0.3.1",
  "description": "CLI for contenz (content validation and codegen)",
  "keywords": [
    "cli",
    "content",
    "contenz",
    "markdown",
    "mdx"
  ],
  "homepage": "https://github.com/viztor/contenz#readme",
  "bugs": {
    "url": "https://github.com/viztor/contenz/issues"
  },
  "license": "MPL-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/viztor/contenz.git",
    "directory": "packages/cli"
  },
  "bin": {
    "__contenz_bash_complete": "./bin/bash-complete.mjs",
    "contenz": "./bin/run.mjs"
  },
  "files": [
    "dist",
    "bin"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint src",
    "lint:fix": "oxlint --fix src"
  },
  "dependencies": {
    "@contenz/core": "workspace:*",
    "@stricli/auto-complete": "catalog:",
    "@stricli/core": "catalog:",
    "tsx": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24"
  }
}
