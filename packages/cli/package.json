{
  "name": "@contenz/cli",
  "version": "0.2.0",
  "description": "CLI for contenz (content validation and codegen)",
  "keywords": [
    "cli",
    "content",
    "contenz",
    "markdown",
    "mdx"
  ],
  "license": "MPL-2.0",
  "bin": {
    "__contenz_bash_complete": "./bin/bash-complete.mjs",
    "contenz": "./bin/run.mjs"
  },
  "files": [
    "dist",
    "bin"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint src",
    "lint:fix": "oxlint --fix src"
  },
  "dependencies": {
    "@contenz/core": "workspace:*",
    "@stricli/auto-complete": "^1.3.0",
    "@stricli/core": "^1.3.0",
    "tsx": "^4.23.4"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=24"
  }
}
