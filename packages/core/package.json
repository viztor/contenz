{
  "name": "@contenz/core",
  "version": "0.2.0",
  "description": "Content validation and codegen from MDX/Markdown with Zod",
  "keywords": [
    "codegen",
    "content",
    "markdown",
    "mdx",
    "validation",
    "zod"
  ],
  "homepage": "https://github.com/viztor/contenz#readme",
  "bugs": {
    "url": "https://github.com/viztor/contenz/issues"
  },
  "license": "MPL-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/viztor/contenz.git",
    "directory": "packages/core"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./api": {
      "types": "./dist/api.d.ts",
      "import": "./dist/api.js",
      "default": "./dist/api.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup && tsc --emitDeclarationOnly --declarationMap",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src",
    "lint:fix": "oxlint --fix src",
    "format": "oxfmt --write src",
    "check": "oxlint src",
    "knip": "knip"
  },
  "dependencies": {
    "@orama/orama": "^3.1.18",
    "@orama/plugin-data-persistence": "^3.1.18",
    "fast-glob": "^3.3.3",
    "p-map": "^7.0.6",
    "picocolors": "^1.1.1",
    "tsx": "^4.23.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@vitest/coverage-istanbul": "^4.1.10",
    "knip": "^6.31.0",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=24"
  }
}
