{
  "name": "@contenz/core",
  "version": "0.3.1",
  "description": "Content validation and codegen from MDX/Markdown with Zod",
  "keywords": [
    "codegen",
    "content",
    "markdown",
    "mdx",
    "validation",
    "zod"
  ],
  "homepage": "https://github.com/viztor/contenz#readme",
  "bugs": {
    "url": "https://github.com/viztor/contenz/issues"
  },
  "license": "MPL-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/viztor/contenz.git",
    "directory": "packages/core"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./api": {
      "types": "./dist/api.d.ts",
      "import": "./dist/api.js",
      "default": "./dist/api.js"
    },
    "./reader": {
      "types": "./dist/reader.d.ts",
      "import": "./dist/reader.js",
      "default": "./dist/reader.js"
    },
    "./writer": {
      "types": "./dist/writer.d.ts",
      "import": "./dist/writer.js",
      "default": "./dist/writer.js"
    },
    "./search": {
      "types": "./dist/search.d.ts",
      "import": "./dist/search.js",
      "default": "./dist/search.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup && tsc --emitDeclarationOnly --declarationMap && node scripts/check-edge.mjs && node scripts/check-edge.mjs writer.js && node scripts/check-edge.mjs search.js",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src && node scripts/check-boundary.mjs",
    "lint:fix": "oxlint --fix src",
    "format": "oxfmt --write src",
    "check": "oxlint src",
    "knip": "knip"
  },
  "dependencies": {
    "@orama/orama": "catalog:",
    "@orama/plugin-data-persistence": "catalog:",
    "fast-glob": "catalog:",
    "p-map": "catalog:",
    "picocolors": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@vitest/coverage-istanbul": "catalog:",
    "knip": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24"
  }
}
