{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "project": [
    "src/**/*.ts"
  ],
  "ignoreIssues": {
    "src/config.ts": [
      "exports"
    ],
    "src/generator.ts": [
      "exports",
      "types"
    ],
    "src/parser.ts": [
      "exports",
      "types"
    ],
    "src/validator.ts": [
      "exports",
      "types"
    ]
  },
  "rules": {
    "files": "off",
    "dependencies": "off",
    "unlisted": "off",
    "unresolved": "off",
    "binaries": "off",
    "exports": "off",
    "types": "off"
  }
}
